# Copy to `config.yaml` (gitignored) and fill in your real Azure values.

azure_openai:
  endpoint: "<YOUR_AZURE_OPENAI_ENDPOINT>"
  deployment: "<YOUR_DEPLOYMENT>"
  api_version: "2024-12-01-preview"  # pinned dated-api surface; see README "API surface & version pinning"
  tenant_id: "<YOUR_TENANT_ID>"
  scope: "https://cognitiveservices.azure.com/.default"
  auth: "cli"  # "cli" uses `az login` (tenant_id optional); "browser" requires tenant_id
  reasoning_effort: "low"  # gpt-5.x: none | low | medium | high | xhigh

files:
  input_jsonl: "data/sections.jsonl"
  output_dir: "data"
  output_prefix: "parsed_sections"
  checkpoint: "data/.checkpoint.jsonl"

# Omit this block to parse all sections; otherwise list the subset to parse/emit.
sections:
  - biopsy
  - aspirate
  - flow
  - cell_count
  - immunostains
  - specimen_header
  - final_dx

processing:
  max_concurrency: 20
  target_rpm: 2000
  target_tpm: 200000
  max_retries: 5
  retry_base_delay: 2.0
  log_level: "WARNING"  # DEBUG | INFO | WARNING | ERROR | CRITICAL; CLI --log-level/--quiet override
  dedup: true  # parse byte-identical section text once and fan out the result; toggling invalidates checkpoint
