# Copy to `config.yaml` and replace placeholders with real values

azure_openai:
  endpoint: "<YOUR_AZURE_OPENAI_ENDPOINT>"
  deployment: "<YOUR_DEPLOYMENT>"
  api_version: "2025-04-01-preview"
  scope: "https://cognitiveservices.azure.com/.default"
  auth: "cli"  # "cli" uses `az login` (tenant_id optional); "browser" requires tenant_id
  tenant_id: "<YOUR_TENANT_ID>" # needed only for browser auth, optional for cli
  reasoning_effort: "low"  # none | minimal | low | medium | high | xhigh

files:
  input_jsonl: "data/sections.jsonl"
  output_dir: "data"
  output_prefix: "parsed_sections"
  checkpoint: "data/.checkpoint.jsonl"
  order_id_col: "order_id"  # optional, only used to key checkpoint records when dedup: false
  instance_col: "instance"  # optional, only used to warn on ambiguous order_id repeats

# Required: list the section(s) to parse, everything else in a row is passed through to the output as-is.
sections:
  - biopsy
  - aspirate
  - flow
  - cell_count
  - immunostains
  - specimen_header
  - final_dx

processing:
  max_concurrency: 20
  target_rpm: 2000
  target_tpm: 200000
  max_retries: 5
  retry_base_delay: 2.0
  log_level: "WARNING"  # DEBUG (tune concurrency/rate limits) | WARNING (quiet); CLI --log-level overrides
  dedup: true  # parse byte-identical section text once and fan out the result; toggling mid-run invalidates the checkpoint
