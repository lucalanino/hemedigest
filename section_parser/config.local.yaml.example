# Example local overlay. Copy to `config.local.yaml` (gitignored) and fill in
# real values. Only the keys you want to override need to be present -- this file
# is deep-merged on top of config.yaml at load, so unspecified keys fall through.

azure_openai:
  endpoint: "https://<resource>.openai.azure.com/"
  deployment: "<your deployment name>"
  # Required only when auth is "browser"; with "cli" the tenant comes from `az login`.
  tenant_id: "<your tenant id>"
  # auth: "browser"   # uncomment where Azure CLI auth is unavailable
